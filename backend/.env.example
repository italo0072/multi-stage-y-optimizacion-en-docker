# Referencia de Laravel. Para Docker, configura el .env junto a docker-compose.yml.
# Compose inyecta APP_KEY, JWT_SECRET y DB_PASSWORD desde ese archivo raíz.
APP_NAME="Ecommerce API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --------------------------------------------------------------
# Base de datos MySQL
# --------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=ecommerce
DB_PASSWORD=

# --------------------------------------------------------------
# Sesiones / Cache / Cola
# --------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --------------------------------------------------------------
# JWT Auth (php-open-source-saver/jwt-auth)
# Genera JWT_SECRET con el comando del README y guárdalo en el .env raíz.
# --------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# --------------------------------------------------------------
# Stripe (pasarela de pago)
# Obtener claves en https://dashboard.stripe.com/test/apikeys
# --------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --------------------------------------------------------------
# L5 Swagger
# --------------------------------------------------------------
L5_SWAGGER_CONST_HOST=/api
L5_SWAGGER_GENERATE_ALWAYS=false
L5_FORMAT_TO_USE_FOR_DOCS=json
